# Streamlit Community Cloud 배포 시, 앱 설정(App settings > Secrets)에 이 내용을 붙여넣고
# 아래 값들을 실제 값으로 채워넣으세요. 이 파일 자체(.example 없는 실제 secrets.toml)는
# 로컬에서도 git에 절대 커밋되지 않습니다 (.gitignore 처리됨).

APP_PASSWORD = "여기에 팀 공유용 접속 비밀번호를 정하세요"

[gcp_service_account]
# 서비스계정 JSON 키 파일( ga4-bigquery-377201-xxxx.json )을 열어서,
# 그 안의 키:값을 그대로 아래 형식으로 옮겨 적으세요 (private_key는 줄바꿈 포함 큰따옴표로 감싸기).
type = "service_account"
project_id = "ga4-bigquery-377201"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "..."
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
